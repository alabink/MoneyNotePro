# Chuỗi kết nối MongoDB Atlas (Bắt buộc khi deploy lên Vercel)
# Ví dụ: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/moneynote_pro?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/moneynote_pro?retryWrites=true&w=majority

# Khóa bí mật mã hóa JWT Token
JWT_SECRET=moneynote_pro_super_secret_jwt_key_2026

# Cổng chạy Local (Trên Vercel sẽ tự động quản lý)
PORT=3000
NODE_ENV=production
